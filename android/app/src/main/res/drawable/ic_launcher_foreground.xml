<?xml version="1.0" encoding="utf-8"?>
<!-- A 版图标母版（white/blue dial）的自适应前景矢量图。
     108dp 画布对应母版 128×128 视口：内容中心略低于几何中心（与母版一致），
     表盘外缘半径 ≈38.5 视口单位，位于 66dp 安全圆（≈39.1 视口单位）内。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <!-- 表盘：从 (96,66) 顺时针 270° 到 (64,34)，缺口在右上。 -->
    <path
        android:pathData="M96,66 A32,32 0 1 1 64,34"
        android:strokeColor="#1C52D4"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 表针：圆心指向右上 45°。 -->
    <path
        android:pathData="M64,66 L81,48"
        android:strokeColor="#1C52D4"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 轴心。 -->
    <path
        android:pathData="M64,60 A6,6 0 1 0 64,72 A6,6 0 1 0 64,60"
        android:fillColor="#1C52D4" />
    <!-- 两枚浅蓝刻度：母版中的 5.5×10 圆角矩形，等价于圆头短线。 -->
    <group android:rotation="22" android:pivotX="77.25" android:pivotY="37.5">
        <path
            android:pathData="M77.25,35.25 L77.25,39.75"
            android:strokeColor="#A8CDFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
    <group android:rotation="58" android:pivotX="91.75" android:pivotY="51.5">
        <path
            android:pathData="M91.75,48.75 L91.75,53.25"
            android:strokeColor="#A8CDFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
